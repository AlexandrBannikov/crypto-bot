diff --git a/tests/test_spot_trading_engine.py b/tests/test_spot_trading_engine.py
new file mode 100644
index 0000000..884d8d3
--- /dev/null
+++ b/tests/test_spot_trading_engine.py
@@ -0,0 +1,258 @@
+from pathlib import Path
+
+import pytest
+
+from app.bybit_account import (
+    WalletBalance,
+    WalletCoinBalance,
+)
+from app.engine import Candle
+from app.order_executor import (
+    DryRunOrderExecutor,
+    OrderSide,
+    OrderStatus,
+)
+from app.paper_state import PaperStateStore
+from app.spot_trading_engine import (
+    BybitSpotTradingConfig,
+    BybitSpotTradingEngine,
+)
+from app.trading_types import TradeAction
+
+
+class StaticFeed:
+    def __init__(
+        self,
+        candles: tuple[Candle, ...],
+    ) -> None:
+        self.candles = candles
+
+    def get_candles(self) -> tuple[Candle, ...]:
+        return self.candles
+
+
+class StaticAccountClient:
+    def __init__(
+        self,
+        balances: dict[str, WalletBalance],
+    ) -> None:
+        self.balances = balances
+
+    def get_wallet_balance(
+        self,
+        *,
+        account_type: str = "UNIFIED",
+        coin: str | None = None,
+    ) -> WalletBalance:
+        assert coin is not None
+        return self.balances[coin]
+
+
+class BuyStrategy:
+    def generate_signal(self, candles, index):
+        return TradeAction.OPEN_LONG
+
+
+class SellStrategy:
+    def generate_signal(self, candles, index):
+        return TradeAction.CLOSE_LONG
+
+
+class HoldStrategy:
+    def generate_signal(self, candles, index):
+        return TradeAction.HOLD
+
+
+class StopBuyStrategy:
+    def generate_signal(self, candles, index):
+        from app.trade_signal import TradeSignal
+
+        return TradeSignal(
+            action=TradeAction.OPEN_LONG,
+            stop_loss=95,
+        )
+
+
+def make_candles() -> tuple[Candle, ...]:
+    return (
+        Candle(1, 100, 101, 99, 100, 1),
+        Candle(2, 110, 111, 109, 110, 1),
+        Candle(3, 120, 121, 119, 120, 1),
+    )
+
+
+def make_wallet(
+    coin: str,
+    amount: float,
+    *,
+    available: float | None = None,
+) -> WalletBalance:
+    return WalletBalance(
+        account_type="UNIFIED",
+        total_equity=available,
+        total_wallet_balance=(
+            amount if available is None else available
+        ),
+        total_available_balance=available,
+        coins=(
+            WalletCoinBalance(
+                coin=coin,
+                wallet_balance=amount,
+            ),
+        ),
+    )
+
+
+def make_engine(
+    tmp_path: Path,
+    *,
+    strategy=None,
+    usdt_amount: float = 1000,
+    eth_amount: float = 0,
+    executor: DryRunOrderExecutor | None = None,
+) -> BybitSpotTradingEngine:
+    return BybitSpotTradingEngine(
+        feed=StaticFeed(make_candles()),
+        strategy=strategy or BuyStrategy(),
+        account_client=StaticAccountClient(
+            {
+                "USDT": make_wallet(
+                    "USDT",
+                    usdt_amount,
+                    available=usdt_amount,
+                ),
+                "ETH": make_wallet(
+                    "ETH",
+                    eth_amount,
+                ),
+            }
+        ),
+        order_executor=executor or DryRunOrderExecutor(),
+        config=BybitSpotTradingConfig(
+            symbol="ETHUSDT",
+            base_coin="ETH",
+            quote_coin="USDT",
+            state_file=tmp_path / "spot_state.json",
+        ),
+    )
+
+
+def test_spot_engine_plans_buy_from_quote_balance(
+    tmp_path: Path,
+) -> None:
+    executor = DryRunOrderExecutor()
+    engine = make_engine(
+        tmp_path,
+        executor=executor,
+    )
+
+    result = engine.run_once()
+
+    assert result.received_candles == 3
+    assert result.processed_candles == 3
+    assert result.quote_available_balance == pytest.approx(
+        1000
+    )
+    assert result.base_wallet_balance == pytest.approx(0)
+    assert result.has_base_position is False
+    assert result.planned_order is not None
+    assert result.planned_order.side == OrderSide.BUY
+    assert result.planned_order.quantity == pytest.approx(
+        1000 / 120
+    )
+    assert result.order_result is not None
+    assert result.order_result.status == OrderStatus.ACCEPTED
+    assert executor.orders == (result.planned_order,)
+
+
+def test_spot_engine_uses_base_balance_as_position_for_sell(
+    tmp_path: Path,
+) -> None:
+    engine = make_engine(
+        tmp_path,
+        strategy=SellStrategy(),
+        eth_amount=0.25,
+    )
+
+    result = engine.run_once()
+
+    assert result.has_base_position is True
+    assert result.planned_order is not None
+    assert result.planned_order.side == OrderSide.SELL
+    assert result.planned_order.quantity == pytest.approx(
+        0.25
+    )
+
+
+def test_spot_engine_skips_duplicate_buy_when_eth_exists(
+    tmp_path: Path,
+) -> None:
+    engine = make_engine(
+        tmp_path,
+        strategy=BuyStrategy(),
+        eth_amount=0.25,
+    )
+
+    result = engine.run_once()
+
+    assert result.has_base_position is True
+    assert result.planned_order is None
+
+
+def test_spot_engine_returns_no_order_for_hold(
+    tmp_path: Path,
+) -> None:
+    executor = DryRunOrderExecutor()
+    engine = make_engine(
+        tmp_path,
+        strategy=HoldStrategy(),
+        executor=executor,
+    )
+
+    result = engine.run_once()
+
+    assert result.planned_order is None
+    assert result.order_result is None
+    assert executor.orders == ()
+
+
+def test_spot_engine_skips_duplicate_cycle(
+    tmp_path: Path,
+) -> None:
+    engine = make_engine(tmp_path)
+
+    first = engine.run_once()
+    second = engine.run_once()
+
+    assert first.planned_order is not None
+    assert second.processed_candles == 0
+    assert second.planned_order is None
+
+
+def test_spot_engine_saves_timestamp(
+    tmp_path: Path,
+) -> None:
+    engine = make_engine(tmp_path)
+
+    engine.run_once()
+
+    saved = PaperStateStore(
+        tmp_path / "spot_state.json"
+    ).load()
+
+    assert saved.last_candle_timestamp == 3
+
+
+def test_spot_engine_rejects_attached_stop_loss(
+    tmp_path: Path,
+) -> None:
+    engine = make_engine(
+        tmp_path,
+        strategy=StopBuyStrategy(),
+    )
+
+    with pytest.raises(
+        ValueError,
+        match="spot orders",
+    ):
+        engine.run_once()
-- 
