diff --git a/app/spot_trading_engine.py b/app/spot_trading_engine.py
new file mode 100644
index 0000000..8029e10
--- /dev/null
+++ b/app/spot_trading_engine.py
@@ -0,0 +1,300 @@
+from dataclasses import dataclass
+from pathlib import Path
+
+from app.bybit_account import (
+    BybitAccountClient,
+    WalletBalance,
+)
+from app.engine import Strategy
+from app.market_data import MarketDataFeed
+from app.order_executor import (
+    DirectOrderExecutor,
+    OrderRequest,
+    OrderResult,
+)
+from app.order_planner import OrderPlanner
+from app.paper_session import PaperPosition
+from app.paper_state import (
+    PaperSessionState,
+    PaperStateStore,
+)
+from app.risk import RiskConfig
+from app.trading_types import PositionSide
+
+
+@dataclass(frozen=True, slots=True)
+class BybitSpotTradingConfig:
+    symbol: str
+    base_coin: str
+    quote_coin: str = "USDT"
+    state_file: Path = Path(
+        "state/bybit_spot_state.json"
+    )
+    account_type: str = "UNIFIED"
+    risk_config: RiskConfig | None = None
+    minimum_base_position: float = 0.0
+
+    def __post_init__(self) -> None:
+        normalized_symbol = self.symbol.strip().upper()
+        normalized_base_coin = (
+            self.base_coin.strip().upper()
+        )
+        normalized_quote_coin = (
+            self.quote_coin.strip().upper()
+        )
+
+        if not normalized_symbol:
+            raise ValueError("symbol must not be empty")
+
+        if not normalized_base_coin:
+            raise ValueError(
+                "base_coin must not be empty"
+            )
+
+        if not normalized_quote_coin:
+            raise ValueError(
+                "quote_coin must not be empty"
+            )
+
+        if not self.account_type.strip():
+            raise ValueError(
+                "account_type must not be empty"
+            )
+
+        if self.minimum_base_position < 0:
+            raise ValueError(
+                "minimum_base_position must not be negative"
+            )
+
+        object.__setattr__(
+            self,
+            "symbol",
+            normalized_symbol,
+        )
+        object.__setattr__(
+            self,
+            "base_coin",
+            normalized_base_coin,
+        )
+        object.__setattr__(
+            self,
+            "quote_coin",
+            normalized_quote_coin,
+        )
+
+
+@dataclass(frozen=True, slots=True)
+class BybitSpotTradingResult:
+    received_candles: int
+    processed_candles: int
+    planned_order: OrderRequest | None
+    order_result: OrderResult | None
+    signal_timestamp: int | None
+    last_candle_timestamp: int | None
+    quote_available_balance: float
+    base_wallet_balance: float
+    has_base_position: bool
+
+
+class BybitSpotTradingEngine:
+    def __init__(
+        self,
+        *,
+        feed: MarketDataFeed,
+        strategy: Strategy,
+        account_client: BybitAccountClient,
+        order_executor: DirectOrderExecutor,
+        config: BybitSpotTradingConfig,
+    ) -> None:
+        self.feed = feed
+        self.strategy = strategy
+        self.account_client = account_client
+        self.order_executor = order_executor
+        self.config = config
+
+    def run_once(self) -> BybitSpotTradingResult:
+        candles = tuple(self.feed.get_candles())
+
+        if not candles:
+            raise ValueError(
+                "market data feed returned no candles"
+            )
+
+        state_store = PaperStateStore(
+            self.config.state_file
+        )
+        state = state_store.load()
+
+        previous_timestamp = (
+            state.last_candle_timestamp
+        )
+
+        new_candles = tuple(
+            candle
+            for candle in candles
+            if (
+                previous_timestamp is None
+                or candle.timestamp > previous_timestamp
+            )
+        )
+
+        quote_balance = (
+            self.account_client.get_wallet_balance(
+                account_type=self.config.account_type,
+                coin=self.config.quote_coin,
+            )
+        )
+        base_balance = (
+            self.account_client.get_wallet_balance(
+                account_type=self.config.account_type,
+                coin=self.config.base_coin,
+            )
+        )
+
+        quote_available_balance = (
+            _available_balance(quote_balance)
+        )
+        base_wallet_balance = (
+            _wallet_coin_balance(
+                base_balance,
+                self.config.base_coin,
+            )
+        )
+
+        latest_close = candles[-1].close
+        current_position = (
+            None
+            if (
+                base_wallet_balance
+                <= self.config.minimum_base_position
+            )
+            else _spot_position_from_balance(
+                quantity=base_wallet_balance,
+                reference_price=latest_close,
+            )
+        )
+
+        if not new_candles:
+            return BybitSpotTradingResult(
+                received_candles=len(candles),
+                processed_candles=0,
+                planned_order=None,
+                order_result=None,
+                signal_timestamp=None,
+                last_candle_timestamp=previous_timestamp,
+                quote_available_balance=(
+                    quote_available_balance
+                ),
+                base_wallet_balance=base_wallet_balance,
+                has_base_position=(
+                    current_position is not None
+                ),
+            )
+
+        candle = new_candles[-1]
+        index = candles.index(candle)
+        signal = self.strategy.generate_signal(
+            candles,
+            index,
+        )
+
+        planned_order = OrderPlanner(
+            symbol=self.config.symbol,
+            risk_config=self.config.risk_config,
+        ).plan(
+            signal=signal,
+            balance=quote_available_balance,
+            reference_price=candle.close,
+            current_position=current_position,
+        )
+
+        if (
+            planned_order is not None
+            and planned_order.stop_loss is not None
+        ):
+            raise ValueError(
+                "spot orders do not support attached stop_loss"
+            )
+
+        order_result = (
+            None
+            if planned_order is None
+            else self.order_executor.submit_order(
+                planned_order
+            )
+        )
+
+        state_store.save(
+            PaperSessionState(
+                last_candle_timestamp=(
+                    candle.timestamp
+                ),
+                virtual_balance=(
+                    quote_available_balance
+                ),
+            )
+        )
+
+        return BybitSpotTradingResult(
+            received_candles=len(candles),
+            processed_candles=len(new_candles),
+            planned_order=planned_order,
+            order_result=order_result,
+            signal_timestamp=candle.timestamp,
+            last_candle_timestamp=candle.timestamp,
+            quote_available_balance=(
+                quote_available_balance
+            ),
+            base_wallet_balance=base_wallet_balance,
+            has_base_position=(
+                current_position is not None
+            ),
+        )
+
+
+def _available_balance(
+    balance: WalletBalance,
+) -> float:
+    value = (
+        balance.total_available_balance
+        if balance.total_available_balance is not None
+        else balance.total_wallet_balance
+    )
+
+    if value is None:
+        raise ValueError(
+            "Bybit wallet has no available balance"
+        )
+
+    return value
+
+
+def _wallet_coin_balance(
+    balance: WalletBalance,
+    coin: str,
+) -> float:
+    for coin_balance in balance.coins:
+        if coin_balance.coin == coin:
+            return coin_balance.wallet_balance
+
+    return 0.0
+
+
+def _spot_position_from_balance(
+    *,
+    quantity: float,
+    reference_price: float,
+) -> PaperPosition:
+    if reference_price <= 0:
+        raise ValueError(
+            "reference_price must be greater than zero"
+        )
+
+    return PaperPosition(
+        side=PositionSide.LONG,
+        entry_timestamp=0,
+        entry_price=reference_price,
+        quantity=quantity,
+        entry_fee=0,
+        entry_cost=quantity * reference_price,
+    )
