+import os
+
+from app.bybit_account import (
+    BybitAccountClient,
+    BybitAccountConfig,
+)
+
+
+API_KEY_ENV = "BYBIT_MAINNET_API_KEY"
+API_SECRET_ENV = "BYBIT_MAINNET_API_SECRET"
+
+
+def main() -> None:
+    api_key = os.environ.get(API_KEY_ENV, "")
+    api_secret = os.environ.get(API_SECRET_ENV, "")
+
+    if not api_key or not api_secret:
+        raise SystemExit(
+            "Set BYBIT_MAINNET_API_KEY and "
+            "BYBIT_MAINNET_API_SECRET first"
+        )
+
+    client = BybitAccountClient(
+        BybitAccountConfig(
+            api_key=api_key,
+            api_secret=api_secret,
+            testnet=False,
+        )
+    )
+
+    usdt = client.get_wallet_balance(
+        account_type="UNIFIED",
+        coin="USDT",
+    )
+    eth = client.get_wallet_balance(
+        account_type="UNIFIED",
+        coin="ETH",
+    )
+
+    print("Bybit mainnet account — read only")
+    print("USDT account type:", usdt.account_type)
+    print("USDT total equity:", usdt.total_equity)
+    print(
+        "USDT wallet balance:",
+        usdt.total_wallet_balance,
+    )
+    print(
+        "USDT available balance:",
+        usdt.total_available_balance,
+    )
+
+    if eth.coins:
+        print("ETH wallet balance:", eth.coins[0].wallet_balance)
+        print("ETH usd value:", eth.coins[0].usd_value)
+    else:
+        print("ETH wallet balance: 0")
+
+
+if __name__ == "__main__":
+    main()
