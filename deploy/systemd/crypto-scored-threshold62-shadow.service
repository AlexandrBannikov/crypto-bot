[Unit]
Description=Optional scored candidate threshold-62 shadow contour
After=network-online.target crypto-scored-candidate-shadow.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/crypto-bot
EnvironmentFile=/etc/crypto-bot/paper-shadow.env
ExecStart=/opt/crypto-bot/venv/bin/python /opt/crypto-bot/scripts/run_scored_threshold62_shadow.py --state /opt/crypto-bot/state/scored_candidate_threshold62/runtime.json --decisions /opt/crypto-bot/state/scored_candidate_threshold62/decisions.jsonl --lock-file /opt/crypto-bot/state/scored_candidate_threshold62/runtime.lock --threshold65-decisions /opt/crypto-bot/state/scored_candidate_shadow/decisions.jsonl
StandardOutput=journal
StandardError=journal

