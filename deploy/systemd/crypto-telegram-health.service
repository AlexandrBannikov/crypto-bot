[Unit]
Description=Send transition-only crypto paper health alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
SupplementaryGroups=crypto-bot-runtime
StateDirectory=crypto-bot-telegram-health
StateDirectoryMode=0700
WorkingDirectory=/opt/crypto-bot
EnvironmentFile=/etc/crypto-bot/telegram.env
ExecStart=/opt/crypto-bot/venv/bin/python /opt/crypto-bot/scripts/telegram_health.py --notification-state-path /var/lib/crypto-bot-telegram-health/telegram_notifications.json
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
StandardOutput=journal
StandardError=journal
