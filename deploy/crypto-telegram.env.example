# Dedicated Telegram bot for crypto-bot. Never reuse a polling bot token from
# another service. Copy to /etc/crypto-bot/telegram.env with mode 0600.
CRYPTO_TELEGRAM_ENABLED=false
CRYPTO_TELEGRAM_BOT_TOKEN=
CRYPTO_TELEGRAM_CHAT_ID=
CRYPTO_TELEGRAM_TIMEZONE=Asia/Yekaterinburg
CRYPTO_TELEGRAM_MORNING_TIME=09:00
CRYPTO_TELEGRAM_EVENING_TIME=21:00

# Safe, non-secret mirror of the paper runtime mode. Keep these values aligned
# with /etc/crypto-bot/paper-shadow.env; do not add exchange credentials here.
REGIME_FILTER_MODE=shadow
LIVE_TRADING_ENABLED=false
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_PERCENT=2.0
MAX_DRAWDOWN_PERCENT=10.0
MAX_DATA_AGE_SECONDS=7200
HALT_ON_API_ERROR=true

# Explicit read-only production artifact paths.
CONTROLLER_STATE_PATH=/opt/crypto-bot/state/trading_controller.json
CONTROLLER_LAST_CANDLE_PATH=/opt/crypto-bot/state/trading_controller_last_candle.txt
REGIME_RUNTIME_STATE_PATH=/opt/crypto-bot/state/regime_runtime.json
CONTROLLER_TRADE_JOURNAL_PATH=/opt/crypto-bot/state/controller_trade_journal.jsonl
SHADOW_DIAGNOSTICS_PATH=/opt/crypto-bot/state/shadow_decisions.jsonl
CONTROLLER_LOCK_PATH=/opt/crypto-bot/state/bybit_controller.lock
