# Safe paper-only configuration. Copy to /etc/crypto-bot/paper-shadow.env.
PAPER_STRATEGY_MODE=shadow
SHADOW_DIAGNOSTICS_ENABLED=true
SHADOW_DIAGNOSTICS_PATH=state/shadow_decisions.jsonl
CONTROLLER_TRADE_JOURNAL_PATH=state/controller_trade_journal.jsonl
SYMBOL=ETHUSDT
TIMEFRAME=60

# Regime detector defaults; shadow does not use these decisions for execution.
REGIME_ADX_PERIOD=14
REGIME_ADX_THRESHOLD=20
REGIME_ATR_PERIOD=14
REGIME_LOW_VOLATILITY_THRESHOLD=0.005
REGIME_HIGH_VOLATILITY_THRESHOLD=0.02
REGIME_MINIMUM_CONFIDENCE=0.0
